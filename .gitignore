# .gitignore for Trekking Management App V1

# Node.js & React build
node_modules/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# SQLite database (auto-generated at runtime)
instance/
*.db

# Project report (binary, not tracked in version control)
Project_Report.pdf

# Virtual environments
.venv/
venv/
env/

# OS files
Thumbs.db
.DS_Store

# Distribution / packaging
*.egg-info/

dist/
build/

# Node dependencies
node_modules/

